
# Database Configuration
# =====================================================================
# IMPORTANT: Browser applications CANNOT connect directly to MySQL
# These environment variables would be used by a backend server (Node.js/Express)
# that this frontend application would call via API endpoints
# =====================================================================

# Backend API URL (when implemented)
VITE_API_URL=http://localhost:5000/api

# These would be used by your backend server, not the frontend
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=manufacturing
DB_PORT=3306

# Note: The current frontend uses mock data and cannot directly 
# connect to MySQL from the browser environment
