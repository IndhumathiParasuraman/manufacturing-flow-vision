
# Database Configuration
# =====================================================================
# Frontend configuration for API connection
VITE_API_URL=http://localhost:5000/api

# Backend Server Configuration (used by the Node.js server)
# These are not used by the frontend directly
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=manufacturing
DB_PORT=3306

# Note: Create a copy of this file named .env and update the values
# with your actual database credentials

